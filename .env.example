# ============================================
# TeleTools Bot - Environment Variables
# ============================================
# Copy file ini jadi .env lalu isi datanya
# Command: copy .env.example .env
# ============================================

# ===========================================
# 🔑 WAJIB DIISI
# ===========================================

# Bot Token dari @BotFather
BOT_TOKEN=

# User ID admin (pisah dengan koma kalau lebih dari 1)
# Cara dapat: chat @userinfobot di Telegram
ADMIN_IDS=123456789,987654321

# ===========================================
# 📱 OPSIONAL - Telegram API (untuk fitur advanced)
# ===========================================

# Dari https://my.telegram.org
API_ID=0
API_HASH=

# ===========================================
# 💾 DATABASE
# ===========================================

# Path file database (default: teletools.db)
DATABASE_PATH=teletools.db

# ===========================================
# 🛡 ANTI-SPAM
# ===========================================

# Aksi spam: mute / kick / ban / delete
SPAM_ACTION=mute

# Max pesan per menit per user (lebih = spam)
SPAM_MAX_MESSAGES=5

# Max link per pesan
SPAM_MAX_LINKS=3

# Durasi mute dalam detik (3600 = 1 jam)
SPAM_MUTE_DURATION=3600

# ===========================================
# 🔐 CAPTCHA
# ===========================================

# Tipe captcha: math / button
CAPTCHA_TYPE=math

# Timeout captcha dalam detik (120 = 2 menit)
CAPTCHA_TIMEOUT=120

# ===========================================
# ⏰ TIMEZONE
# ===========================================

# Timezone untuk auto-poster
# WIB = Asia/Jakarta
# WITA = Asia/Makassar
# WIT = Asia/Jayapura
POSTER_TIMEZONE=Asia/Jakarta

# ===========================================
# 📝 LOG LEVEL
# ===========================================

# Level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
